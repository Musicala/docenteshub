rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email in [
        "alekcaballeromusic@gmail.com", "catalina.medina.leal@gmail.com",
        "musicalaasesor@gmail.com", "adminmusicala@gmail.com"
      ];
    }
    function ownsFolder(teacherEmail) { return signedIn() && request.auth.token.email == teacherEmail; }
    function validEvidence() {
      return request.resource != null && (
        (request.resource.contentType.matches('image/.*') && request.resource.size <= 8 * 1024 * 1024) ||
        (request.resource.contentType.matches('video/.*') && request.resource.size <= 30 * 1024 * 1024)
      );
    }
    match /academic-evidence/{teacherEmail}/{taskId}/{logId}/{fileName} {
      allow read: if ownsFolder(teacherEmail) || isAdmin();
      allow create, update: if (ownsFolder(teacherEmail) || isAdmin()) && validEvidence();
      allow delete: if ownsFolder(teacherEmail) || isAdmin();
    }
    /* Expediente de contratación. Documentos personales: cada docente solo
       alcanza su carpeta y coordinación puede consultarlas todas. Nadie
       borra ni sobrescribe: cada versión va en su propia carpeta. */
    function validDossierFile() {
      return request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && (
          request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'image/jpeg'
          || request.resource.contentType == 'image/png'
        );
    }

    match /contract-files/{teacherEmail}/{requirementId}/{versionId}/{fileName} {
      allow read: if ownsFolder(teacherEmail) || isAdmin();
      allow create: if (ownsFolder(teacherEmail) || isAdmin()) && validDossierFile();
      allow update, delete: if false;
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
