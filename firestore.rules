rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    // Lista base (en código). Sigue funcionando aunque la colección hubUsers
    // esté vacía. Se puede inhabilitar a un docente base con un doc en hubUsers
    // que tenga enabled == false.
    function baseHubEmail() {
      return request.auth.token.email in [
        'alekcaballeromusic@gmail.com',
        'catalina.medina.leal@gmail.com',
        'emilybg0102@gmail.com',
        'annitolad@gmail.com',
        'lorenaduarte.404@gmail.com',
        'malego2709@gmail.com',
        'bagutierrezm@gmail.com',
        'darasaxcifuentes@gmail.com'
      ];
    }

    function hubUserPath() {
      return /databases/$(database)/documents/hubUsers/$(request.auth.token.email);
    }
    // Acceso temporal: accessExpiresAt (epoch ms). Si no existe o es null/0, no vence.
    function hubNotExpired() {
      return !('accessExpiresAt' in get(hubUserPath()).data)
        || get(hubUserPath()).data.accessExpiresAt == null
        || get(hubUserPath()).data.accessExpiresAt == 0
        || request.time.toMillis() < get(hubUserPath()).data.accessExpiresAt;
    }
    function hubManagedEnabled() {
      return exists(hubUserPath())
        && get(hubUserPath()).data.enabled == true
        && hubNotExpired();
    }
    function hubManagedDisabled() {
      return exists(hubUserPath()) && get(hubUserPath()).data.enabled == false;
    }

    // Tiene acceso si: es de la base (y no está inhabilitado), o tiene un doc
    // gestionado habilitado. Los docentes se gestionan desde el panel admin.
    function isTeacherHubUser() {
      return signedIn()
        && (
          (baseHubEmail() && !hubManagedDisabled())
          || hubManagedEnabled()
        );
    }

    function isAdminReader() {
      return signedIn()
        && request.auth.token.email in [
          'alekcaballeromusic@gmail.com',
          'catalina.medina.leal@gmail.com'
        ];
    }

    function writesOwnTeacherRecord() {
      return isTeacherHubUser()
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'docente'
        && request.resource.data.action in ['inicio_clase', 'fin_jornada']
        && request.resource.data.modalidad in ['sede', 'hogar', 'virtual', 'jornada']
        && request.resource.data.source in ['qr_sede', 'manual_hogar', 'manual_virtual', 'manual_fin', 'auto_cierre', 'auto_fin_sin_cierre'];
    }

    function readsOwnRecord() {
      return isTeacherHubUser()
        && resource.data.email == request.auth.token.email;
    }

    function writesOwnTeacherShiftSession(sessionId) {
      return isTeacherHubUser()
        && sessionId == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
    }

    match /teacherClassStartRecords/{recordId} {
      allow create: if writesOwnTeacherRecord() || isAdminReader();
      allow read: if readsOwnRecord() || isAdminReader();
      allow update, delete: if false;
    }

    match /teacherOpenShiftSessions/{sessionId} {
      allow get: if (isTeacherHubUser() && sessionId == request.auth.uid)
        || isAdminReader();
      allow list: if isAdminReader();
      allow create, update: if writesOwnTeacherShiftSession(sessionId) || isAdminReader();
      allow delete: if false;
    }

    // Horarios esperados por docente (config base). Solo admins.
    match /teacherSchedules/{email} {
      allow get: if isAdminReader() || (signedIn() && email == request.auth.token.email);
      allow list, create, update, delete: if isAdminReader();
    }

    // Ajustes de horario por día puntual (overrides). Admins ven todo; cada docente puede leer sus propios ajustes.
    match /teacherScheduleOverrides/{overrideId} {
      allow get: if isAdminReader() || (signedIn() && resource.data.email == request.auth.token.email);
      allow list, create, update, delete: if isAdminReader();
    }

    /* ====================================================================
       MÓDULO BITÁCORA ACADÉMICA (Trabajo por objetivos)
       Cada docente lee/escribe SOLO su información (teacherEmail == su correo).
       La coordinación (admin) puede leer y escribir todo.
    ==================================================================== */
    function academicReadOwn() {
      return isTeacherHubUser()
        && resource.data.teacherEmail == request.auth.token.email;
    }
    function academicWriteOwn() {
      // El doc nuevo se marca como suyo y, si ya existía, también era suyo.
      return isTeacherHubUser()
        && request.resource.data.teacherEmail == request.auth.token.email
        && (resource == null || resource.data.teacherEmail == request.auth.token.email);
    }
    function academicDeleteOwn() {
      return isTeacherHubUser()
        && resource.data.teacherEmail == request.auth.token.email;
    }

    match /academicObjectives/{docId} {
      allow read: if isAdminReader() || academicReadOwn();
      allow create, update: if isAdminReader() || academicWriteOwn();
      allow delete: if isAdminReader() || academicDeleteOwn();
    }
    match /academicTaskBudgets/{docId} {
      allow read: if isAdminReader() || academicReadOwn();
      allow create, update: if isAdminReader() || academicWriteOwn();
      allow delete: if isAdminReader() || academicDeleteOwn();
    }
    match /academicTaskHourLogs/{docId} {
      allow read: if isAdminReader() || academicReadOwn();
      allow create, update: if isAdminReader() || academicWriteOwn();
      allow delete: if isAdminReader() || academicDeleteOwn();
    }

    // Gestión de acceso al HUB. Solo admins escriben/listan. Cada usuario puede
    // leer su propio doc (lo usa el front para decidir si puede entrar).
    match /hubUsers/{userEmail} {
      allow get: if isAdminReader() || (signedIn() && userEmail == request.auth.token.email);
      allow list: if isAdminReader();
      allow create, update, delete: if isAdminReader();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
